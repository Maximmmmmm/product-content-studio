# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real secrets.

# HTTP port the NestJS API listens on.
PORT=3001

# Origin of the Next.js frontend, used for CORS (credentialed requests only
# from this exact origin are allowed).
FRONTEND_ORIGIN=http://localhost:3000

# SQLite connection string used by Prisma. Relative paths are resolved against
# the directory holding schema.prisma, so this points at backend/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session JWTs. Use a long random string in any
# real deployment; the value below is a placeholder only.
JWT_SECRET=replace-with-a-long-random-string

# Session lifetime, in seconds (3600 = 1 hour). The session cookie's lifetime
# is derived from the token's own expiry, so the two can never disagree.
JWT_EXPIRES_IN_SECONDS=3600

# Seed data for the test administrator (used only by `prisma db seed`,
# never read at request time). Change these before seeding if you want a
# different admin login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
